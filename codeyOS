#!/data/data/com.termux/files/usr/bin/bash
#
# codeyOS - Codey-OS CLI Client
#
# Status/task/cancel/background commands use the verified daemon socket.
# Interactive prompts and --daemon delegate directly to main.
#

if ! _CODEY_SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}")" || [ ! -f "$_CODEY_SCRIPT" ]; then
    printf 'Cannot resolve installed Codey-OS entrypoint.\n' >&2
    exit 2
fi
CODEY_OS_DIR="$(cd -- "${_CODEY_SCRIPT%/*}" && pwd -P)" || exit 2
unset _CODEY_SCRIPT
# Fixed code receives every prompt, option, ID, and configured path as data.
# exec preserves the Python operation's exit/signal status without temp cleanup.
exec python3 "$CODEY_OS_DIR/core/cli_client.py" "$@"
