#!/data/data/com.termux/files/usr/bin/bash
# Verified daemon lifecycle; public gateway envelope is handled separately.
set -e
if ! _CODEY_SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}")" || [ ! -f "$_CODEY_SCRIPT" ]; then
    printf 'Cannot resolve installed Codey-OS entrypoint.\n' >&2
    exit 2
fi
CODEY_OS_DIR="$(cd -- "${_CODEY_SCRIPT%/*}" && pwd -P)" || exit 2
unset _CODEY_SCRIPT

export CODEY_OS_DIR
source "$CODEY_OS_DIR/lib/service_manager.sh"

show_status() {
    python3 "$CODEY_OS_DIR/core/service_lifecycle.py" daemon-status
}
kill_llama_server_gracefully() { svc_operation llama-server-8080 stop; }
restart_all() { svc_operation daemon restart; }
reload_daemon() { svc_operation daemon reload; }
case "${1:-status}" in
    start) start_daemon ;;
    stop) stop_daemon ;;
    status) show_status ;;
    restart) restart_all ;;
    reload) reload_daemon ;;
    config) python3 "$CODEY_OS_DIR/core/service_lifecycle.py" config-create ;;
    *) printf 'Usage: codeydOS {start|stop|status|restart|reload|config}\n' >&2; exit 2 ;;
esac
