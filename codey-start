#!/data/data/com.termux/files/usr/bin/bash
#
# codey-start - Codey-OS Orchestrator (daemon + GUI + TUI, all at once)
#
# Brings up the daemon (if not already running), starts the GUI server in
# the background, then drops into the interactive TUI (codeyOS) in the
# foreground — TUI and GUI stay live simultaneously, with the daemon
# guaranteed up first.
#
# By design, exiting the TUI (Ctrl+C or natural exit) stops the GUI server
# but leaves the daemon running — daemon mode's whole point is to keep
# serving in the background after an interactive session ends. Use
# `codey-stop` to bring everything down explicitly.
#

set -e

CODEY_OS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_DIR="$HOME/.codeyOS"
PID_FILE="$DAEMON_DIR/codeyOS.pid"
SOCKET_FILE="$DAEMON_DIR/codeyOS.sock"

mkdir -p "$DAEMON_DIR"

# Check if daemon is running (same detection logic codeyOS uses)
is_daemon_running() {
    if [ ! -f "$PID_FILE" ]; then
        return 1
    fi

    PID=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -z "$PID" ]; then
        return 1
    fi

    if ! kill -0 "$PID" 2>/dev/null; then
        return 1
    fi

    if [ ! -S "$SOCKET_FILE" ]; then
        return 1
    fi

    return 0
}

# ── 1. Daemon ────────────────────────────────────────────────────────────────
if is_daemon_running; then
    echo "  Daemon → already running (PID $(cat "$PID_FILE"))"
else
    echo "  Daemon → starting..."
    bash "$CODEY_OS_DIR/codeydOS" start
fi

# ── 2. GUI server (background) ──────────────────────────────────────────────
GUI_PORT="${CODEY_GUI_PORT:-8888}"
GUI_PID_FILE="$DAEMON_DIR/gui-server.pid"
GUI_STARTED_HERE="false"

if [ -f "$GUI_PID_FILE" ] && kill -0 "$(cat "$GUI_PID_FILE" 2>/dev/null)" 2>/dev/null; then
    echo "  GUI    → http://localhost:${GUI_PORT}  (already running)"
elif [ -f "$CODEY_OS_DIR/gui/server.py" ]; then
    export PYTHONUNBUFFERED=1
    export CODEY_GUI_PORT="$GUI_PORT"
    python3 "$CODEY_OS_DIR/gui/server.py" &
    echo $! > "$GUI_PID_FILE"
    GUI_STARTED_HERE="true"
    echo "  GUI    → http://localhost:${GUI_PORT}"
fi

# Stop the GUI server on exit (Ctrl+C or natural exit) — but NOT the daemon.
# Only tear down the GUI if we're the one who started it.
if [ "$GUI_STARTED_HERE" = "true" ]; then
    trap 'echo; echo "  Stopping GUI server..."; kill "$(cat "$GUI_PID_FILE" 2>/dev/null)" 2>/dev/null; rm -f "$GUI_PID_FILE"' EXIT
fi

echo "  TUI    → launching codeyOS..."
echo

# ── 3. TUI (foreground) ─────────────────────────────────────────────────────
bash "$CODEY_OS_DIR/codeyOS" "$@"
