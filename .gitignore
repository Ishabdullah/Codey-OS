# Python cache
__pycache__/
*.py[cod]
*$py.class

# SQLite files
*.db
*.sqlite
*.sqlite3

# Model weights
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.h5
*.pb
*.onnx
*.weights

# API keys and secrets
.env
.env.local
.env.production
*secret*
*token*
*apikey*
*api_key*
config.json
config.*.json
*.secret.json
!config.json.example
# Test file whose name legitimately contains "secret" (NEW-458 backup tests)
!tests/test_backup_secrets.py
# Source/test files whose names legitimately contain "token" (WP0.7,
# 2026-10-07) -- not secret files themselves, silently excluded from
# `git add` with no warning until noticed via `git status --short`
# showing nothing for a file known to exist on disk.
!tools/encrypt_cloudflare_token.py
!tests/test_wp0_7_cloudflare_token_encryption.py

# CCOS runtime state — rebuilt from plugin manifests / accumulates during
# normal use, not meant to carry committed content between sessions.
ccos/data/capabilities.json
ccos/data/reflections.jsonl
# WP0.6 quarantine copies (tools/quarantine_unsourced_ccos_metrics.py) --
# same runtime-state reasoning, plus these are the stated rollback copies
# (CODEY_OS_MASTER_BLUEPRINT.md §21's "Rollback: restore from the moved
# copy") and must not be silently deletable by git clean -fd while also
# being untracked (code-review finding, same shape as NEW-797).
ccos/data/reflections.jsonl.quarantined-*

# PID files
*.pid

# Session log directories (32-char hex)
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/

# live-verifier scratch test files — must live inside WORKSPACE_ROOT so
# core/filesystem.py's _validate_path() boundary check passes (NEW-60),
# but never committed.
.live_verify_scratch/
