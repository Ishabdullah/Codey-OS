#!/data/data/com.termux/files/usr/bin/bash
#
# codey-stop - Codey-OS Orchestrator (stop all running services cleanly)
#
# Shuts down all running Codey-OS services (Cloudflare tunnel, Aigentik,
# Restoricon API, and main daemon) following Rule 3 PID-tracked lifecycle.
#

set -e

if ! _CODEY_SCRIPT="$(readlink -f -- "${BASH_SOURCE[0]}")" || [ ! -f "$_CODEY_SCRIPT" ]; then
    printf 'Cannot resolve installed Codey-OS entrypoint.\n' >&2
    exit 2
fi
CODEY_OS_DIR="$(cd -- "${_CODEY_SCRIPT%/*}" && pwd -P)" || exit 2
unset _CODEY_SCRIPT
export CODEY_OS_DIR
export CODEY_DIR="$CODEY_OS_DIR"

source "$CODEY_OS_DIR/lib/service_manager.sh"

stop_all_services
